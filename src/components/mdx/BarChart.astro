---
// Horizontal bar chart, one series, drawn at build time.
// bars: [{ label: "3D-UNet", value: 2.28, detail: "0.287 vs 0.126 samples/s" }]
interface Props { title: string; bars: { label: string; value: number; detail?: string }[]; unit?: string; baseline?: { value: number; label: string }; note?: string }
const { title, bars, unit = '', baseline, note } = Astro.props;
const max = Math.max(...bars.map((b) => b.value), baseline?.value ?? 0) * 1.12;
---
<figure class="bc reveal">
  <figcaption class="bc__title">{title}</figcaption>
  <div class="bc__rows" style={baseline ? `--base:${(baseline.value / max).toFixed(4)}` : undefined}>
    {bars.map((b) => (
      <div class="bc__row" tabindex="0" title={b.detail}>
        <span class="bc__label">{b.label}</span>
        <span class="bc__track">
          <span class="bc__bar" style={`--w:${(b.value / max) * 100}%`}></span>
          <span class="bc__val" style={`--w:${(b.value / max) * 100}%`}>{b.value.toFixed(2)}{unit}</span>
        </span>
        {b.detail && <span class="bc__detail">{b.detail}</span>}
      </div>
    ))}
    {baseline && <span class="bc__base" aria-hidden="true"><span>{baseline.label}</span></span>}
  </div>
  {note && <p class="bc__note">{note}</p>}
</figure>

<style>
  .bc { margin: 28px 0; padding: 20px 20px 16px; border-radius: 16px; border: 1px solid var(--line); background: linear-gradient(160deg, #130e1f, #0b0812); }
  .bc__title { font-family: var(--font-display); font-weight: 600; font-size: 1.02rem; margin-bottom: 18px; }
  .bc__rows { position: relative; display: grid; gap: 14px; --label: 150px; }
  .bc__row { display: grid; grid-template-columns: var(--label) 1fr; align-items: center; column-gap: 14px; outline: none; border-radius: 8px; }
  .bc__row:focus-visible { box-shadow: 0 0 0 2px var(--accent-2); }
  .bc__label { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-2); }
  .bc__track { position: relative; height: 26px; }
  .bc__bar { position: absolute; left: 0; top: 0; bottom: 0; width: var(--w); border-radius: 0 4px 4px 0; background: linear-gradient(90deg, var(--accent-3), #b57bff); transform-origin: left; transition: transform 1.1s var(--ease), filter 0.2s; }
  .bc__row:hover .bc__bar, .bc__row:focus .bc__bar { filter: brightness(1.25); }
  .reveal:not(.is-visible) .bc__bar { transform: scaleX(0); }
  .bc__val { position: absolute; left: calc(var(--w) + 8px); top: 50%; transform: translateY(-50%); font-family: var(--font-mono); font-size: 0.82rem; font-weight: 700; color: #fff; }
  .bc__detail { grid-column: 2; font-size: 0.74rem; color: var(--muted); font-family: var(--font-mono); margin-top: 3px; }
  .bc__base { position: absolute; top: -6px; bottom: -6px; left: calc(var(--label) + 14px + (100% - var(--label) - 14px) * var(--base)); width: 0; border-left: 1px dashed rgba(255, 255, 255, 0.5); }
  .bc__base span { position: absolute; top: -16px; left: 4px; font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-2); white-space: nowrap; }
  .bc__note { font-size: 0.84rem; color: var(--muted); margin: 14px 0 0; }
  @media (max-width: 560px) { .bc__rows { --label: 96px; } }
</style>
