---
// Renders a LaTeX formula at build time (no JavaScript sent to the browser).
// Usage:  <Tex expr="v = \frac{\omega r}{\cos\theta}" block />
import katex from 'katex';
import 'katex/dist/katex.min.css';
interface Props { expr: string; block?: boolean; label?: string }
const { expr, block = false, label } = Astro.props;
const html = katex.renderToString(expr, { displayMode: block, throwOnError: false, output: 'html' });
---
{block ? (
  <div class="tex-block reveal">
    <div class="tex-block__math" set:html={html} />
    {label && <span class="tex-block__label">{label}</span>}
  </div>
) : (
  <span class="tex-inline" set:html={html} />
)}

<style is:global>
  .grid > .tex-block { margin: 0; }
  .tex-block {
    position: relative;
    margin: 26px 0;
    padding: 24px 22px;
    border-radius: 14px;
    border: 1px solid var(--line-strong);
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.1), rgba(18, 14, 28, 0.6));
    overflow-x: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
  }
  .tex-block__math { font-size: 1.25rem; color: #fff; }
  .tex-block__label { position: absolute; top: 8px; right: 12px; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.1em; color: var(--accent-2); text-transform: uppercase; }
  .tex-inline { color: #fff; }
  .katex { font-size: 1.08em; }
</style>
