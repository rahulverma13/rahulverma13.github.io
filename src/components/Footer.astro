---
import site from '../data/site.json';
const year = new Date().getFullYear();
---
<footer class="footer" id="contact">
  <div class="container">
    <div class="footer__cta reveal">
      <p class="eyebrow" data-scramble>Contact</p>
      <h2 class="footer__title">Let's build something.</h2>
      <p class="footer__lede">
        I'm looking for engineering internships and lab positions in robotics, mechatronics, controls and hardware.
        The fastest way to reach me is email.
      </p>
      <div class="footer__actions">
        <a class="btn btn--primary" href={`mailto:${site.email}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          {site.email}
        </a>
        <a class="btn" href={site.linkedin} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.6 8.65 21 11.2 21 14.5V21h-4v-5.8c0-1.4-.03-3.2-1.95-3.2-1.95 0-2.25 1.52-2.25 3.1V21H9z"/></svg>
          LinkedIn
        </a>
        <a class="btn" href={site.github} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.1-1.47-1.1-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
          GitHub
        </a>
        <a class="btn" href={site.resume} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M9 14h6M9 17h4"/></svg>
          Resume (PDF)
        </a>
      </div>
    </div>
    <div class="footer__base">
      <span>© {year} {site.name}</span>
      <span class="footer__mono">Designed in CAD. Built in code.</span>
    </div>
  </div>
</footer>

<style>
  .footer { margin-top: clamp(80px, 12vw, 160px); border-top: 1px solid var(--line); background: linear-gradient(180deg, rgba(124, 58, 237, 0.08), transparent 60%); }
  .footer__cta { padding: clamp(64px, 9vw, 120px) 0 clamp(48px, 7vw, 80px); max-width: 860px; }
  .footer__title { font-size: clamp(2.6rem, 7vw, 5.2rem); margin: 18px 0 20px; background: linear-gradient(90deg, #fff 30%, var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .footer__lede { color: var(--text-2); max-width: 600px; font-size: 1.08rem; }
  .footer__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .footer__base { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding: 24px 0 36px; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; }
  .footer__mono { font-family: var(--font-mono); }
  @media (max-width: 520px) { .footer__actions .btn { width: 100%; justify-content: center; } }
</style>
